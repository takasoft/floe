# Copy to `.env` and adjust. docker compose reads this automatically.

# --- MinIO (S3-compatible object store / Iceberg warehouse) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
FLOE_BUCKET=floe-warehouse

# --- Postgres (PyIceberg SQL catalog backing store) ---
POSTGRES_USER=floe
POSTGRES_PASSWORD=floe
POSTGRES_DB=floe

# --- Optional: large synthetic dataset for performance testing ---
# floe-seed loads the small curated quickstart dataset when this is 0.
# Set a positive row count (e.g. 2000000) to generate a large, FK-consistent
# dataset; safety events and defects scale as a percentage of deliveries.
FLOE_SEED_DELIVERIES=0
# FLOE_SEED_DAYS=30
# FLOE_SEED_DAS=2000
# FLOE_SEED_ROUTES=800
# FLOE_SEED_SAFETY_PCT=8
# FLOE_SEED_DEFECT_PCT=4
